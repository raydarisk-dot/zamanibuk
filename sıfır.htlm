<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Yeni Hayat 2.0 – Dönüşüm Sistemi</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      background: #050508;
      color: #e5e5e5;
      font-family: 'Inter', system-ui, sans-serif;
      min-height: 100vh;
      padding: 20px;
    }
    .wrap {
      max-width: 1100px;
      margin: 0 auto;
    }
    .hero {
      background: #0a0b12;
      border: 1px solid #1e1e30;
      border-radius: 24px;
      padding: 28px 20px;
      text-align: center;
      margin-bottom: 18px;
    }
    .hero h1 {
      font-weight: 900;
      letter-spacing: 0.12em;
      background: linear-gradient(180deg, #6a6a8a, #3a3a52);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      font-size: 32px;
      text-transform: uppercase;
    }
    .divider {
      height: 1px;
      background: #1e1e30;
      margin: 12px auto;
      width: 60%;
    }
    .hero .date {
      color: #777;
      font-size: 11px;
      letter-spacing: 0.15em;
    }
    .countdown {
      display: flex;
      gap: 10px;
      justify-content: center;
      margin-top: 16px;
      flex-wrap: wrap;
    }
    .cd {
      background: #0f101a;
      border: 1px solid #23263e;
      border-radius: 14px;
      min-width: 70px;
      padding: 8px 6px;
      text-align: center;
    }
    .cd .n {
      font-size: 22px;
      font-weight: 900;
      color: #fff;
    }
    .cd .l {
      font-size: 10px;
      color: #777;
      letter-spacing: 0.1em;
    }
    .circle-wrap {
      display: flex;
      justify-content: center;
      margin-top: 14px;
    }
    .circle {
      width: 90px;
      height: 90px;
      border-radius: 50%;
      border: 3px solid #1e1e30;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      background: conic-gradient(#fbbf24 var(--p, 0%), #12131d 0);
    }
    .circle span {
      position: absolute;
      width: 74px;
      height: 74px;
      background: #050508;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 900;
      font-size: 16px;
    }
    .strip {
      background: #0c0d16;
      border: 1px solid #1e1e30;
      border-radius: 16px;
      padding: 12px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin: 14px 0;
      flex-wrap: wrap;
      gap: 10px;
    }
    .days {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }
    .d {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 9px;
      font-weight: 700;
      flex-direction: column;
      border: 1px solid #23263e;
      background: #12131d;
      color: #666;
    }
    .d.full { background: #16a34a; color: #fff; border-color: #16a34a; }
    .d.part { background: #eab308; color: #000; }
    .d.empty { background: #12131d; color: #666; }
    .d.today { border-color: #fbbf24; box-shadow: 0 0 12px #fbbf2440; }
    .streak { font-weight: 800; font-size: 13px; }
    .phase {
      background: #0f101a;
      border: 1px solid #23263e;
      border-radius: 20px;
      padding: 18px;
      margin: 14px 0;
      position: relative;
      overflow: hidden;
      transition: opacity 0.3s;
    }
    .phase.locked { opacity: 0.7; }
    .phase .header {
      display: flex;
      gap: 12px;
      align-items: center;
      margin-bottom: 12px;
    }
    .phase .badge {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 900;
      color: #000;
      flex-shrink: 0;
    }
    .phase .title {
      font-weight: 800;
      font-size: 15px;
    }
    .phase .sub {
      font-size: 11px;
      color: #888;
    }
    .task {
      display: flex;
      align-items: center;
      gap: 10px;
      background: #12131d;
      border: 1px solid #23263e;
      border-radius: 12px;
      padding: 8px 12px;
      margin: 5px 0;
      cursor: pointer;
      transition: 0.15s;
    }
    .task.done { opacity: 0.6; }
    .task.done .task-text { text-decoration: line-through; color: #999; }
    .task .dot {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      border: 1px solid #3a405f;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #1a1d2e;
      font-size: 12px;
      flex-shrink: 0;
    }
    .task.done .dot { background: #fbbf24; border-color: #fbbf24; color: #000; }
    .task .tag {
      font-size: 8px;
      background: #23263e;
      padding: 2px 8px;
      border-radius: 999px;
      color: #aaa;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .task .bonus-tag { background: #2a2a3a; color: #eab308; }
    .task .mandatory-tag { background: #1a3a2a; color: #4ade80; }
    .phase .progress {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 11px;
      color: #666;
      margin-top: 10px;
    }
    .phase .bar {
      width: 100px;
      height: 5px;
      background: #12131d;
      border-radius: 999px;
      overflow: hidden;
    }
    .phase .bar-inner {
      height: 100%;
      border-radius: 999px;
      transition: width 0.4s;
    }
    .lock-overlay {
      position: absolute;
      inset: 0;
      background: rgba(5,5,8,0.85);
      backdrop-filter: blur(6px);
      z-index: 5;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 20px;
    }
    .lock-overlay .inner {
      background: #0a0a0f;
      border: 1px solid #1e1e30;
      padding: 20px;
      border-radius: 16px;
      max-width: 320px;
    }
    .footer {
      text-align: center;
      color: #444;
      font-size: 10px;
      letter-spacing: 0.12em;
      margin-top: 24px;
      font-weight: 600;
    }
    .wildcard-badge {
      background: #2a1a3a;
      border: 1px solid #6a3a8a;
      border-radius: 999px;
      padding: 4px 14px;
      font-size: 11px;
      color: #d4a0f0;
    }
    @media (max-width: 600px) {
      .hero h1 { font-size: 24px; }
      .cd { min-width: 60px; padding: 6px; }
      .cd .n { font-size: 18px; }
    }
  </style>
</head>
<body>
<div class="wrap">
  <div class="hero">
    <h1>YENİ HAYAT 2.0</h1>
    <div class="divider"></div>
    <div class="date">
      <span id="tarih">--</span><br>
      <b id="gungun">GÜN 1 / 365</b> • <span id="hedef">HEDEF 14 ŞUBAT 2027</span>
    </div>
    <div class="countdown">
      <div class="cd"><div class="n" id="cd-d">0</div><div class="l">GÜN</div></div>
      <div class="cd"><div class="n" id="cd-h">0</div><div class="l">SAAT</div></div>
      <div class="cd"><div class="n" id="cd-m">0</div><div class="l">DAKİKA</div></div>
      <div class="cd"><div class="n" id="cd-s">0</div><div class="l">SANİYE</div></div>
    </div>
    <div class="circle-wrap"><div class="circle" id="circle"><span id="pct">%0</span></div></div>
  </div>

  <div class="strip">
    <div>
      <b style="font-size:10px; letter-spacing:0.15em; color:#777;">SON 7 GÜN</b>
      <div class="days" id="days"></div>
    </div>
    <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
      <span class="wildcard-badge" id="wildcardDisplay">🛡️ Mazeret: 1/1</span>
      <span class="streak" id="streak">🔥 0 gün</span>
    </div>
  </div>

  <div id="phases"></div>
  <div class="footer">© 2026 – 2027 • Esnek Dönüşüm Sistemi • Başlangıç: 01.08.2026</div>
</div>

<script>
  // ---------- TANIMLAR ----------
  const START = new Date(2026, 7, 1, 0, 0, 0);
  const TARGET = new Date(2027, 1, 14, 23, 59, 59);
  const TOTAL_DAYS = 197; // hedefe kalan gün sayısı

  // Faz tanımları – her fazda zorunlu (mandatory) ve bonus (bonus) görevler
  const PHASES = [
    {
      id: 1,
      title: "FAZ I: TEMEL TAŞLAR",
      sub: "Güne sağlam başla",
      startDay: 1,
      endDay: 5,
      color: "#7c3aed",
      tasks: [
        { text: "Yatağını topla", type: "mandatory" },
        { text: "Dişlerini fırçala (2 dk)", type: "mandatory" },
        { text: "En az 2 bardak su iç", type: "mandatory" },
        { text: "Kahvaltı yap", type: "mandatory" },
        { text: "Günlük dua / meditasyon", type: "mandatory" },
        { text: "El ve yüz bakımı", type: "bonus" },
      ]
    },
    {
      id: 2,
      title: "FAZ II: DÜZEN & HİJYEN",
      sub: "Çevren seni yansıtır",
      startDay: 6,
      endDay: 12,
      color: "#0891b2",
      tasks: [
        { text: "Evi düzenle / topla", type: "mandatory" },
        { text: "Bulaşıkları yıka", type: "mandatory" },
        { text: "Çamaşırları kontrol et", type: "mandatory" },
        { text: "Sakal traşı / tıraş", type: "mandatory" },
        { text: "Günlük kıyafetini hazırla", type: "bonus" },
        { text: "Ayakkabılarını temizle", type: "bonus" },
      ]
    },
    {
      id: 3,
      title: "FAZ III: SAĞLIK & ENERJİ",
      sub: "Bedenine iyi bak",
      startDay: 13,
      endDay: 20,
      color: "#059669",
      tasks: [
        { text: "6-7 saat uyku", type: "mandatory" },
        { text: "Mekik (en az 20)", type: "mandatory" },
        { text: "Şınav (en az 10)", type: "mandatory" },
        { text: "Vitamin / Pharmaton", type: "mandatory" },
        { text: "Duş al", type: "mandatory" },
        { text: "Akıllı saati tak", type: "bonus" },
        { text: "3 km yürüyüş / koşu", type: "bonus" },
      ]
    },
    {
      id: 4,
      title: "FAZ IV: ZİHİN & BİLGİ",
      sub: "Keskin zihin keskin silah",
      startDay: 21,
      endDay: 30,
      color: "#4f46e5",
      tasks: [
        { text: "10 dk kitap oku", type: "mandatory" },
        { text: "İngilizce kelime (10 adet)", type: "mandatory" },
        { text: "Python veya Excel çalış (15 dk)", type: "mandatory" },
        { text: "Günlük yapılacak listesini gözden geçir", type: "mandatory" },
        { text: "Metalurji notlarını oku", type: "bonus" },
        { text: "İngilizce gramer", type: "bonus" },
      ]
    },
    {
      id: 5,
      title: "FAZ V: DİSİPLİN & SESSİZLİK",
      sub: "Kendine hâkim ol",
      startDay: 31,
      endDay: 42,
      color: "#dc2626",
      tasks: [
        { text: "Hiçbir şeyi erteleme (bugün yap)", type: "mandatory" },
        { text: "Gereksiz harcama yapma", type: "mandatory" },
        { text: "Kimse hakkında yorum yapma", type: "mandatory" },
        { text: "Argo / gereksiz konuşma", type: "mandatory" },
        { text: "Planlarından kimseye bahsetme", type: "bonus" },
        { text: "İşyerinde sadece iş konuş", type: "bonus" },
      ]
    },
    {
      id: 6,
      title: "FAZ VI: USTALIK",
      sub: "Tüm kazanımları sürdür",
      startDay: 43,
      endDay: 197,
      color: "#fbbf24",
      tasks: [
        { text: "Önceki fazlardan 5 zorunlu görevi seç ve yap", type: "mandatory" },
        { text: "Günlük disiplini sağla", type: "mandatory" },
        { text: "Kendine 5 dk ayır (nefes / plan)", type: "mandatory" },
        { text: "Ekstra: 2 bonus görev daha ekle", type: "bonus" },
      ]
    }
  ];

  // ---------- YARDIMCILAR ----------
  function todayKey() { return new Date().toISOString().slice(0, 10); }
  function dayIndex() {
    const now = new Date();
    const diff = Math.floor((now - START) / 86400000) + 1;
    return Math.min(Math.max(diff, 1), TOTAL_DAYS);
  }
  function addDays(date, n) {
    const d = new Date(date);
    d.setDate(d.getDate() + n);
    return d;
  }
  function load() {
    try { return JSON.parse(localStorage.getItem('yh2_data') || '{}'); } catch { return {}; }
  }
  function save(data) {
    try { localStorage.setItem('yh2_data', JSON.stringify(data)); } catch {}
  }

  // ---------- VERİ YAPISI ----------
  // data = { "2026-08-01": { "0_0": true, "0_1": false, ... }, "wildcard_used": ["2026-08-05"], ... }
  let data = load();
  if (!data.wildcard_used) data.wildcard_used = [];
  if (!data.streak) data.streak = 0;

  // ---------- TEMEL FONKSİYONLAR ----------
  function getTodayChecked() {
    const key = todayKey();
    return data[key] || {};
  }

  function getDayChecked(dateStr) {
    return data[dateStr] || {};
  }

  function getTasksForDay(dayNum) {
    // Hangi fazın içindeyiz?
    const phase = PHASES.find(p => dayNum >= p.startDay && dayNum <= p.endDay);
    if (!phase) return [];
    return phase.tasks.map((t, idx) => ({
      ...t,
      id: `${phase.id}_${idx}`,
      phaseId: phase.id,
    }));
  }

  function getMandatoryCount(dayNum) {
    const tasks = getTasksForDay(dayNum);
    return tasks.filter(t => t.type === 'mandatory').length;
  }

  function getCompletedMandatory(dateStr, dayNum) {
    const tasks = getTasksForDay(dayNum);
    const mandatory = tasks.filter(t => t.type === 'mandatory');
    const checked = getDayChecked(dateStr);
    let count = 0;
    mandatory.forEach(t => {
      if (checked[t.id]) count++;
    });
    return count;
  }

  function getPhaseCompletion(phaseId, dateStr, dayNum) {
    const phase = PHASES.find(p => p.id === phaseId);
    if (!phase) return 0;
    const mandatory = phase.tasks.filter(t => t.type === 'mandatory');
    if (mandatory.length === 0) return 1;
    const checked = getDayChecked(dateStr);
    let done = 0;
    mandatory.forEach(t => {
      const tid = `${phaseId}_${phase.tasks.indexOf(t)}`;
      if (checked[tid]) done++;
    });
    return done / mandatory.length;
  }

  function isPhaseUnlocked(phaseId, currentDay) {
    if (phaseId === 1) return true;
    const prevPhase = PHASES.find(p => p.id === phaseId - 1);
    if (!prevPhase) return true;
    // Önceki fazın tamamlanma yüzdesi en az %70 olmalı
    // Bunu bugüne kadar tüm günlerdeki ortalama ile hesaplayalım.
    // Daha basit: kullanıcının o fazın tüm zorunlu görevlerini en az 1 kez yapmış olması? 
    // Daha adil: o fazın başlangıç ve bugün arasındaki günlerdeki tamamlama ortalaması %70 üstü.
    let total = 0, count = 0;
    for (let d = prevPhase.startDay; d <= Math.min(currentDay, prevPhase.endDay); d++) {
      const dateObj = addDays(START, d - 1);
      const dateStr = dateObj.toISOString().slice(0, 10);
      const comp = getPhaseCompletion(prevPhase.id, dateStr, d);
      total += comp;
      count++;
    }
    if (count === 0) return false;
    const avg = total / count;
    return avg >= 0.7;
  }

  // ---------- RENDER ----------
  function render() {
    const now = new Date();
    const todayStr = todayKey();
    const currentDay = dayIndex();

    // Üst bilgi
    document.getElementById('tarih').textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric', weekday: 'long' });
    document.getElementById('gungun').textContent = `GÜN ${currentDay} / ${TOTAL_DAYS}`;
    const diff = TARGET - now;
    let dd = Math.floor(diff / 86400000), hh = Math.floor((diff % 86400000) / 3600000), mm = Math.floor((diff % 3600000) / 60000), ss = Math.floor((diff % 60000) / 1000);
    if (diff < 0) dd = hh = mm = ss = 0;
    document.getElementById('cd-d').textContent = dd;
    document.getElementById('cd-h').textContent = hh;
    document.getElementById('cd-m').textContent = mm;
    document.getElementById('cd-s').textContent = ss;
    const totalMs = TARGET - START;
    const pct = Math.max(0, Math.min(100, ((now - START) / totalMs) * 100));
    document.getElementById('pct').textContent = `%${pct.toFixed(1)}`;
    document.getElementById('circle').style.setProperty('--p', pct + '%');

    // Son 7 gün
    let daysHTML = '';
    for (let i = 6; i >= 0; i--) {
      const d = new Date(now);
      d.setDate(d.getDate() - i);
      const ds = d.toISOString().slice(0, 10);
      const dayNum = Math.floor((d - START) / 86400000) + 1;
      const tasks = getTasksForDay(dayNum);
      const mandatory = tasks.filter(t => t.type === 'mandatory');
      const checked = getDayChecked(ds);
      let done = 0;
      mandatory.forEach(t => { if (checked[t.id]) done++; });
      const total = mandatory.length || 1;
      const ratio = done / total;
      let cls = 'empty';
      if (ratio >= 0.7) cls = 'full';
      else if (ratio > 0) cls = 'part';
      if (ds === todayStr) cls += ' today';
      const label = d.toLocaleDateString('tr-TR', { day: '2-digit', month: 'short' });
      daysHTML += `<div class="d ${cls}">${cls==='full'?'✓':cls==='part'?'%':''}<small style="font-size:7px;margin-top:1px">${label}</small></div>`;
    }
    document.getElementById('days').innerHTML = daysHTML;

    // Wildcard
    const wildcardUsed = data.wildcard_used || [];
    const weeklyWildcard = 1;
    const usedThisWeek = wildcardUsed.filter(date => {
      const d = new Date(date);
      const now = new Date();
      const diffDays = Math.floor((now - d) / 86400000);
      return diffDays < 7 && diffDays >= 0;
    }).length;
    const remaining = Math.max(0, weeklyWildcard - usedThisWeek);
    document.getElementById('wildcardDisplay').textContent = `🛡️ Mazeret: ${remaining}/${weeklyWildcard}`;

    // Streak
    let streak = 0;
    let d = new Date(now);
    while (true) {
      const ds = d.toISOString().slice(0, 10);
      const dayNum = Math.floor((d - START) / 86400000) + 1;
      if (dayNum < 1 || dayNum > TOTAL_DAYS) break;
      const tasks = getTasksForDay(dayNum);
      const mandatory = tasks.filter(t => t.type === 'mandatory');
      const checked = getDayChecked(ds);
      let done = 0;
      mandatory.forEach(t => { if (checked[t.id]) done++; });
      const total = mandatory.length || 1;
      const ratio = done / total;
      // Eğer wildcard kullanılmışsa o gün sayılmaz ama bozmaz
      const isWildcard = wildcardUsed.includes(ds);
      if (ratio >= 0.7 || isWildcard) {
        streak++;
        d.setDate(d.getDate() - 1);
      } else {
        break;
      }
      if (streak > 365) break;
    }
    document.getElementById('streak').textContent = `🔥 ${streak} gün`;

    // Fazlar
    let html = '';
    PHASES.forEach(phase => {
      const unlocked = isPhaseUnlocked(phase.id, currentDay);
      const isActive = currentDay >= phase.startDay && currentDay <= phase.endDay;
      const isPast = currentDay > phase.endDay;
      const isFuture = currentDay < phase.startDay;
      const locked = !unlocked || isFuture;

      // Fazın bugünkü tamamlama oranı
      let completion = 0;
      if (isActive || isPast) {
        const mandatory = phase.tasks.filter(t => t.type === 'mandatory');
        if (mandatory.length) {
          const checked = getDayChecked(todayStr);
          let done = 0;
          mandatory.forEach(t => {
            const tid = `${phase.id}_${phase.tasks.indexOf(t)}`;
            if (checked[tid]) done++;
          });
          completion = done / mandatory.length;
        } else completion = 1;
      }

      html += `<div class="phase ${locked ? 'locked' : ''}" style="border-color:${phase.color}40;">`;

      if (locked) {
        let lockMsg = '';
        if (isFuture) {
          const startDate = addDays(START, phase.startDay - 1);
          const diffDays = Math.ceil((startDate - now) / 86400000);
          lockMsg = `🔒 Bu faz ${diffDays} gün sonra açılacak (Gün ${phase.startDay})`;
        } else if (!unlocked) {
          lockMsg = '🔒 Önceki fazı en az %70 tamamlamadan bu faz açılmaz.';
        } else {
          lockMsg = '🔒 Henüz başlamadı.';
        }
        html += `<div class="lock-overlay"><div class="inner"><div style="font-size:28px;margin-bottom:6px;">🔒</div><div style="font-size:12px;font-weight:900;letter-spacing:0.1em;color:#eab308;">KİLİTLİ</div><div style="font-size:13px;margin-top:6px;color:#ccc;">${lockMsg}</div></div></div>`;
      }

      // Header
      html += `<div class="header">
        <div class="badge" style="background:${phase.color};">${phase.id}</div>
        <div><div class="title">${phase.title}</div><div class="sub">${phase.sub} • Gün ${phase.startDay}-${phase.endDay}</div></div>
      </div>`;

      // Görevler
      phase.tasks.forEach((t, idx) => {
        const tid = `${phase.id}_${idx}`;
        const checked = getDayChecked(todayStr);
        const done = checked[tid] || false;
        const isMandatory = t.type === 'mandatory';
        const tagClass = isMandatory ? 'mandatory-tag' : 'bonus-tag';
        const tagText = isMandatory ? 'ZORUNLU' : 'BONUS';
        html += `<div class="task ${done ? 'done' : ''}" data-tid="${tid}" data-locked="${locked}">
          <div class="dot">${done ? '✓' : ''}</div>
          <span class="task-text">${t.text}</span>
          <span class="tag ${tagClass}">${tagText}</span>
        </div>`;
      });

      // Progress
      const pctDone = Math.round(completion * 100);
      html += `<div class="progress">
        <span>${locked ? '🔒' : (isActive ? 'Bugün' : isPast ? 'Tamamlandı' : 'Henüz başlamadı')} • ${pctDone}%</span>
        <div class="bar"><div class="bar-inner" style="width:${pctDone}%;background:${phase.color};"></div></div>
      </div>`;

      html += `</div>`;
    });
    document.getElementById('phases').innerHTML = html;

    // Task click events
    document.querySelectorAll('.task').forEach(el => {
      el.addEventListener('click', function(e) {
        if (this.dataset.locked === 'true') return;
        const tid = this.dataset.tid;
        const today = todayKey();
        if (!data[today]) data[today] = {};
        data[today][tid] = !data[today][tid];
        if (!data[today][tid]) delete data[today][tid];
        save(data);
        // Ses efekti (basit)
        try {
          const ctx = new (window.AudioContext || window.webkitAudioContext)();
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.value = data[today][tid] ? 880 : 440;
          gain.gain.value = 0.15;
          gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.2);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(ctx.currentTime);
          osc.stop(ctx.currentTime + 0.2);
        } catch(e) {}
        render();
      });
    });
  }

  render();
  setInterval(render, 1000);
</script>
</body>
</html>
