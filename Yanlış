<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Yeni Hayat - ZAMANI BÜK KENDİNİ DÖNÜŞTÜR</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{background:#050508;color:#e5e5e5;font-family:Inter,system-ui,sans-serif;min-height:100vh}
.wrap{max-width:1100px;margin:0 auto;padding:20px}
.hero{background:#050507;border:1px solid #1e1e30;border-radius:24px;padding:28px;text-align:center;margin-bottom:18px}
.hero h1{font-weight:900;letter-spacing:0.15em;line-height:1.05;background:linear-gradient(180deg,#4a4a5e,#2a2a38,#12121a);-webkit-background-clip:text;-webkit-text-fill-color:transparent;-webkit-text-stroke:0.6px #3f3f52;text-shadow:0 1px 0 #000,0 0 22px rgba(120,120,180,0.3);font-size:34px;text-transform:uppercase}
.hero.divider{height:1px;background:#1a1a24;margin:14px auto;width:60%}
.hero.date{color:#555566;font-size:11px;letter-spacing:0.2em;text-transform:uppercase;line-height:1.6}
.hero.date b{color:#6a6a7a}
.countdown{display:flex;gap:10px;justify-content:center;margin-top:18px;flex-wrap:wrap}
.cd{background:#0f101a;border:1px solid #23263e;border-radius:14px;min-width:78px;padding:10px;text-align:center}
.cd.n{font-size:24px;font-weight:900;color:#fff}
.cd.l{font-size:10px;color:#777;letter-spacing:0.15em;margin-top:2px}
.circle-wrap{display:flex;justify-content:center;margin-top:16px}
.circle{width:92px;height:92px;border-radius:50%;border:3px solid #1e1e30;position:relative;display:flex;align-items:center;justify-content:center;background:conic-gradient(#fbbf24 var(--p,0%),#12131d 0)}
.circle span{position:absolute;width:76px;height:76px;background:#050508;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:18px}
.strip{background:#0c0d16;border:1px solid #1e1e30;border-radius:16px;padding:12px 16px;display:flex;justify-content:space-between;align-items:center;margin:14px 0;flex-wrap:wrap;gap:10px}
.days{display:flex;gap:8px;flex-wrap:wrap}
.d{width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;flex-direction:column;border:1px solid #23263e}
.d.full{background:#16a34a;color:#fff;border-color:#16a34a}
.d.part{background:#eab308;color:#000}
.d.empty{background:#12131d;color:#666}
.streak{font-weight:800;font-size:13px}
.phase{background:#0f101a;border:1px solid #23263e;border-radius:20px;padding:18px;margin:14px 0;position:relative;overflow:hidden}
.phase.locked{opacity:0.85}
.lock-bg{position:absolute;inset:0;background:rgba(5,5,8,0.88);backdrop-filter:blur(8px);z-index:5}
.lock-msg{position:absolute;inset:0;z-index:10;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:16px}
.task{display:flex;align-items:center;gap:10px;background:#12131d;border:1px solid #23263e;border-radius:12px;padding:10px 12px;margin:6px 0;cursor:pointer}
.task.done{opacity:0.7}
.task.done span{text-decoration:line-through;color:#999}
.dot{width:22px;height:22px;border-radius:50%;border:1px solid #3a405f;display:flex;align-items:center;justify-content:center;background:#1a1d2e;font-size:12px;flex-shrink:0}
.task.done.dot{background:#fff;border-color:#fff;color:#000}
.task.light{margin-left:auto;width:6px;height:6px;border-radius:50%;background:transparent}
.task.done.light{background:#fbbf24;box-shadow:0 0 10px #fbbf24}
.footer{text-align:center;color:#444;font-size:11px;letter-spacing:0.18em;margin-top:24px;font-weight:600}
</style>
</head>
<body>
<div class="wrap">
<div class="hero">
<h1>ZAMANI BÜK,<br>KENDİNİ DÖNÜŞTÜR</h1>
<div class="divider"></div>
<div class="date"><span id="tarih">--</span><br><b id="gungun">GÜN 1 / 197</b> • <span id="hedef">HEDEF 14 ŞUBAT 2027</span></div>
<div class="countdown">
<div class="cd"><div class="n" id="cd-d">0</div><div class="l">GÜN</div></div>
<div class="cd"><div class="n" id="cd-h">0</div><div class="l">SAAT</div></div>
<div class="cd"><div class="n" id="cd-m">0</div><div class="l">DAKİKA</div></div>
<div class="cd"><div class="n" id="cd-s">0</div><div class="l">SANİYE</div></div>
</div>
<div class="circle-wrap"><div class="circle" id="circle"><span id="pct">%0</span></div></div>
</div>
<div class="strip">
<div><b style="font-size:11px;letter-spacing:0.15em;color:#777">SON 7 GÜN</b><div class="days" id="days"></div></div>
<div class="streak" id="streak">🔥 0 günlük seri</div>
</div>
<div id="phases"></div>
<div class="footer">© 2026-2027 FAZ SİSTEMİ • 197 GÜN • 01.08.2026 BAŞLANGIÇ • WHATSAPP POP</div>
</div>
<script>
const START = new Date(2026,7,1,0,0,0);
const TARGET = new Date(2027,1,14,23,59,59);
const TASKS_ORIGINAL = ["Palanına sadık kal kendine karşı net ol","Sessiz sakin dur","Hergün dua et","Hiçbirşeyi israf etme","Yemeğini evde yap","Günlük kitabını oku","Python çalışmanı yap","Excel çalışmanı yap","Metalurjik çalışmanı yap","İngilizce kelimene çalış","İngilizce gramer çalışmanı yap","Günlük mekik çek","Günlük şınavını çek","Fitness yada 3km koşu yap","Kimse hakkında yorum yapma","Argo cümle kullanma","Günlük 2.5-3 lt suyunu iç","Günlük 6 saat uykunu uyu","Nikotin bandını tak","Akıllı saatini hergün tak","Günde 2 defa dişlerini fırçala","Para harcaması gereksiz yapma","Dışarıdan yemek yeme","Günlük disiplinini sağla","Hiç birşeyi erteleme","El ve yüz bakımı yap","Saç bakımını yap","Günlük sakal traşını ol","Elini yüzünü yıka","Çamaşırları yıka","Evi düzenli temizle","Bulaşıklarını yıka","Pharmaton iç","Kahvaltını yap","Yatağını topla","Yapılacak listeni günlük oku","Reel videolar izleme","Kahve içme","Çay içme","Alkol içme","Sigara içme","İş sonrası duşunu al","Düzenli işe git","İşyerinde kimseyle iş harici muhabbet kurma","Planların hakkında kimseye birşey bahsetme","Kimseden hiç birşey talep etme","Kimseden borç para isteme"];
const PHASES_DEF = [
{id:1,title:"FAZ I: ARINMA",sub:"Savaşçı Uyanıyor",start:1,end:5,color:"#7c3aed",tasks:["Yatağını topla","Günde 2 defa dişlerini fırçala","Elini yüzünü yıka","Günlük sakal traşını ol","Saç bakımını yap","El ve yüz bakımı yap"]},
{id:2,title:"FAZ II: TEMEL",sub:"Ruhun ve Bedenin Direği",start:6,end:12,color:"#0891b2",tasks:["Günlük 6 saat uykunu uyu","Hergün dua et","Kahvaltını yap","Pharmaton iç","Günlük 2.5-3 lt suyunu iç","Akıllı saatini hergün tak"]},
{id:3,title:"FAZ III: SESSIZLIK",sub:"Dilin Kılıcını Kınında Tut",start:13,end:20,color:"#059669",tasks:["Sessiz sakin dur","Kimse hakkında yorum yapma","Argo cümle kullanma","İşyerinde kimseyle iş harici muhabbet kurma","Planların hakkında kimseye birşey bahsetme"]},
{id:4,title:"FAZ IV: ZIRH",sub:"Öfkenin Efendisi Ol",start:21,end:30,color:"#dc2626",tasks:["Kimseden hiç birşey talep etme","Kimseden borç para isteme","Hiç birşeyi erteleme","Günlük disiplinini sağla","Palanına sadık kal kendine karşı net ol"]},
{id:5,title:"FAZ V: ZINCIR KIRAN",sub:"Bağımlılıkları Yak",start:31,end:45,color:"#ea580c",tasks:["Nikotin bandını tak","Sigara içme","Kahve içme","Çay içme","Alkol içme","Reel videolar izleme","Dışarıdan yemek yeme","Yemeğini evde yap"]},
{id:6,title:"FAZ VI: HAZINE",sub:"Paranın Efendisi Ol",start:46,end:53,color:"#d97706",tasks:["Para harcaması gereksiz yapma","Hiçbirşeyi israf etme","Yapılacak listeni günlük oku","Düzenli işe git"]},
{id:7,title:"FAZ VII: DEMIR BEDEN",sub:"Çelikten Vücut",start:54,end:65,color:"#0e7490",tasks:["Fitness yada 3km koşu yap","Günlük şınavını çek","Günlük mekik çek","İş sonrası duşunu al"]},
{id:8,title:"FAZ VIII: DUZEN",sub:"Krallığını Temiz Tut",start:66,end:75,color:"#65a30d",tasks:["Evi düzenli temizle","Bulaşıklarını yıka","Çamaşırları yıka"]},
{id:9,title:"FAZ IX: KESKIN ZIHIN",sub:"Bilgiyle Keskinleş",start:76,end:87,color:"#4f46e5",tasks:["Günlük kitabını oku","Python çalışmanı yap","Excel çalışmanı yap","Metalurjik çalışmanı yap","İngilizce kelimene çalış","İngilizce gramer çalışmanı yap"]},
{id:10,title:"FAZ X: USTALIK EŞİĞİ",sub:"Eşiği Geç",start:88,end:100,color:"#e11d48",tasks:["Yapılacak listeni günlük oku","Günlük disiplinini sağla","Palanına sadık kal kendine karşı net ol"]},
{id:11,title:"FAZ XI: EBEDİ DÖNGÜ",sub:"Ustanın Tekrarı",start:101,end:197,color:"#fbbf24",tasks:TASKS_ORIGINAL}
];
function dayIndex(){let now=new Date();let d=Math.floor((now-START)/86400000)+1;return d<1?1:d>197?197:d}
function addDays(d,n){let x=new Date(d);x.setDate(x.getDate()+n);return x}
function load(){try{return JSON.parse(localStorage.getItem('yh-final')||'{}')}catch(e){return{}}}
function save(o){try{localStorage.setItem('yh-final',JSON.stringify(o))}catch(e){console.warn('Kayıt başarısız:',e)}}
function todayKey(){return new Date().toISOString().slice(0,10)}
let checked=load();
function playTransformSound(done){
try{
let ctx=new (window.AudioContext||window.webkitAudioContext)();
let now=ctx.currentTime;
if(done){
let o1=ctx.createOscillator();let g1=ctx.createGain();
o1.type='sine';o1.frequency.setValueAtTime(1000,now);
g1.gain.setValueAtTime(0.6,now);g1.gain.exponentialRampToValueAtTime(0.001,now+0.15);
o1.connect(g1);g1.connect(ctx.destination);o1.start(now);o1.stop(now+0.2);
let o2=ctx.createOscillator();let g2=ctx.createGain();
o2.type='sine';o2.frequency.setValueAtTime(1500,now+0.08);
g2.gain.setValueAtTime(0.6,now+0.08);g2.gain.exponentialRampToValueAtTime(0.001,now+0.28);
o2.connect(g2);g2.connect(ctx.destination);o2.start(now+0.08);o2.stop(now+0.35);
}else{
let o=ctx.createOscillator();let g=ctx.createGain();
o.type='sine';o.frequency.setValueAtTime(400,now);o.frequency.exponentialRampToValueAtTime(200,now+0.2);
g.gain.setValueAtTime(0.15,now);g.gain.exponentialRampToValueAtTime(0.001,now+0.25);
o.connect(g);g.connect(ctx.destination);o.start(now);o.stop(now+0.3);
}
}catch(e){}
}
function render(){
let now=new Date();
document.getElementById('tarih').textContent=now.toLocaleDateString('tr-TR',{day:'numeric',month:'long',year:'numeric',weekday:'long'});
let di=dayIndex();
document.getElementById('gungun').textContent='GÜN '+di+' / 197';
let diff=TARGET-now;
let dd=Math.floor(diff/86400000);let hh=Math.floor((diff%86400000)/3600000);let mm=Math.floor((diff%3600000)/60000);let ss=Math.floor((diff%60000)/1000);
if(diff<0){dd=hh=mm=ss=0}
document.getElementById('cd-d').textContent=dd;
document.getElementById('cd-h').textContent=hh;
document.getElementById('cd-m').textContent=mm;
document.getElementById('cd-s').textContent=ss;
let total=TARGET-START;
let pct=Math.max(0,Math.min(100,((now-START)/total*100)));
document.getElementById('pct').textContent='%'+pct.toFixed(1);
document.getElementById('circle').style.setProperty('--p',pct+'%');
let html='';
let beforeStart = now < START;
PHASES_DEF.forEach(ph=>{
let startDate=addDays(START,ph.start-1);
let isLocked = beforeStart? true : di < ph.start;
let diffToStart = startDate - now;
let daysUntil=Math.max(0,Math.ceil(diffToStart/86400000));
let hoursUntil=Math.floor(diffToStart/3600000);
let minsUntil=Math.floor((diffToStart%3600000)/60000);
let secsUntil=Math.floor((diffToStart%60000)/1000);
let startStr=startDate.toLocaleDateString('tr-TR');
let todayCount=0;
ph.tasks.forEach((t,idx)=>{
let tid=ph.id+'_'+idx;
if(checked[todayKey()+'_'+tid])todayCount++;
});
let overallPct=ph.tasks.length? (todayCount/ph.tasks.length*100):0;
html+='<div class="phase '+(isLocked?'locked':'')+'" style="border-color:'+ph.color+'30">';
if(isLocked){
let timeText='';
if(diffToStart<=0){timeText=daysUntil+' gün sonra';}
else if(hoursUntil<24){
  if(hoursUntil>0) timeText=hoursUntil+' saat '+minsUntil+' dk sonra';
  else if(minsUntil>0) timeText=minsUntil+' dk '+secsUntil+' sn sonra';
  else timeText=secsUntil+' sn sonra';
  if(ph.id===1) timeText='Başlamasına '+timeText;
  else timeText='Açılmasına '+timeText;
}else{timeText=daysUntil+' gün sonra açılacak';}
html+='<div class="lock-bg"></div><div class="lock-msg"><div style="background:#0a0a0f;border:1px solid #1e1e30;padding:20px;border-radius:16px;box-shadow:0 0 28px rgba(251,191,36,0.15)"><div style="width:56px;height:56px;margin:0 auto 10px;border-radius:14px;background:#0a0a0f;border:1px solid #1e1e30;display:flex;align-items:center;justify-content:center">🔒</div><div style="font-size:12px;font-weight:900;letter-spacing:0.2em;color:#eab308">FAZ '+ph.id+' KİLİTLİ</div><div style="margin-top:6px;font-size:18px;font-weight:900;color:#fff">'+timeText+'</div><div style="margin-top:8px;display:inline-flex;gap:6px;background:#10101a;border:1px solid #1e1e30;border-radius:999px;padding:6px 12px;font-size:11px;font-family:monospace">Açılış: '+startStr+' • Gün '+ph.start+' '+(hoursUntil<24?' • '+hoursUntil+'s '+minsUntil+'dk '+secsUntil+'sn':'')+'</div></div></div>';
}
html+='<div style="display:flex;gap:10px;align-items:center"><div style="width:38px;height:38px;background:'+ph.color+';color:#000;font-weight:900;border-radius:10px;display:flex;align-items:center;justify-content:center">'+ph.id+'</div><div><div style="font-weight:900;font-size:14px">'+ph.title+'</div><div style="font-size:11px;color:#888">'+ph.sub+' • '+ph.tasks.length+' görev • Gün '+ph.start+'-'+ph.end+'</div></div></div><div style="margin-top:12px">';
ph.tasks.forEach((t,idx)=>{
let tid=ph.id+'_'+idx;
let done=!!checked[todayKey()+'_'+tid];
html+='<div class="task '+(done?'done':'')+'" data-tid="'+tid+'" data-locked="'+isLocked+'"><div class="dot">'+(done?'✓':'')+'</div><span>'+t+'</span><div class="light"></div></div>';
});
html+='</div><div style="margin-top:10px;display:flex;justify-content:space-between;align-items:center;font-size:11px;color:#666"><span>';
if(isLocked){html+='🔒 '+daysUntil+' gün sonra açılacak - '+startStr}
else if(ph.start<=di && di<=ph.end){html+='Bugün <b style="color:#fff">'+todayCount+'</b> / '+ph.tasks.length+' • Kalan <b style="color:#fbbf24">'+(ph.tasks.length-todayCount)+'</b>'}
else if(di>ph.end){html+='<span style="color:#10b981">✓ Tamamlandı kabul edildi</span>'}
else{html+='Başlangıç: Gün '+ph.start+' - '+startStr}
html+='</span><div style="width:96px;height:6px;background:#12131d;border-radius:999px;border:1px solid #23263e;overflow:hidden"><div style="height:100%;width:'+(isLocked?0:overallPct)+'%;background:'+ph.color+';transition:width.5s"></div></div></div></div>';
});
document.getElementById('phases').innerHTML=html;
document.querySelectorAll('.task').forEach(el=>{
el.addEventListener('click',()=>{
if(el.dataset.locked==='true')return;
let tid=el.dataset.tid;
let key=todayKey()+'_'+tid;
let was=!!checked[key];
checked[key]=!was;
if(!checked[key])delete checked[key];
save(checked);
playTransformSound(!was);
el.style.boxShadow='0 0 20px '+(was?'transparent':'rgba(251,191,36,0.6)');
setTimeout(()=>el.style.boxShadow='',300);
render();
});
});
let strip='';
for(let i=6;i>=0;i--){
let d=new Date();d.setDate(d.getDate()-i);
let k=d.toISOString().slice(0,10);
let dayIdxForDate=Math.floor((d-START)/86400000)+1;
if(dayIdxForDate<1)dayIdxForDate=1;
if(dayIdxForDate>197)dayIdxForDate=197;
let expected=0;
PHASES_DEF.forEach(ph=>{if(dayIdxForDate>=ph.start && dayIdxForDate<=ph.end){expected=ph.tasks.length;}});
if(expected===0)expected=6;
let cnt=Object.keys(checked).filter(x=>x.startsWith(k)).length;
let cls=cnt>=expected && expected>0?'full':cnt>0?'part':'empty';
let label=d.toLocaleDateString('tr-TR',{day:'2-digit',month:'short'});
strip+='<div class="d '+cls+'">'+(cls==='full'?'✓':cls==='part'?'%':'')+'<small style="font-size:7px;margin-top:1px">'+label+'</small></div>';
}
document.getElementById('days').innerHTML=strip;
let streak=0;let cur=new Date();
while(true){
let k=cur.toISOString().slice(0,10);
let c=Object.keys(checked).filter(x=>x.startsWith(k)).length;
if(c>0){streak++;cur.setDate(cur.getDate()-1);}else break;
if(streak>60)break;
}
document.getElementById('streak').textContent='🔥 '+streak+' günlük seri';
}
render();
setInterval(render,1000);
</script>
</body>
</html>
